{
  "name": "immigration-helper",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "node ./scripts/start-project.js",
    "start:clear": "node ./scripts/start-project.js --clear",
    "stop": "node ./scripts/stop-expo.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android --clear",
    "ios": "expo start --ios --clear",
    "web": "node ./scripts/start-project.js --web --clear",
    "lint": "eslint App.js index.js components/**/*.js constants/**/*.js data/**/*.js screens/**/*.js i18n/**/*.js",
    "test": "node --test tests/*.test.mjs",
    "check:ai": "node ./scripts/check-ai-config.js",
    "setup:ai-key": "node ./scripts/setup-ai-key.js",
    "test:uscis": "node --test tests/uscis-config.test.mjs",
    "test:ai": "node --test tests/ai-answer.test.mjs",
    "test:ai-intent": "node --test tests/ai-intent.test.mjs",
    "test:localization": "node --test tests/localization.test.mjs",
    "test:privacy": "node --test tests/privacy-consent.test.mjs",
    "eval:casepilot": "node --env-file-if-exists=.env ./scripts/evaluate-casepilot.mjs",
    "test:casepilot-live": "node --test tests/casepilot-live-acceptance.test.mjs",
    "uscis:plan": "node ./scripts/scrape-uscis.mjs --dry-run",
    "uscis:scrape": "node ./scripts/scrape-uscis.mjs",
    "uscis:package": "node ./scripts/package-uscis-corpus.mjs",
    "ai:server": "node --env-file-if-exists=.env ./server/index.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "franc": "6.2.0",
    "htmlparser2": "^10.1.0",
    "i18next": "^25.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.2.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.3.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "qrcode-terminal": "0.12.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "postcss": "8.5.28",
    "nanoid": "3.3.18",
    "shell-quote": "1.10.0",
    "@expo/plist": {
      "@xmldom/xmldom": "0.8.15"
    },
    "plist": {
      "@xmldom/xmldom": "0.9.12"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    },
    "@eslint/eslintrc": {
      "js-yaml": "4.3.2"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "uuid": "11.1.1"
  },
  "private": true
}
